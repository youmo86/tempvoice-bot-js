[Unit]
Description=Discord TempVoice - vocaux temporaires
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=tempvoice
Group=tempvoice
WorkingDirectory=/opt/tempvoice-bot
EnvironmentFile=/opt/tempvoice-bot/.env
ExecStart=/usr/bin/node /opt/tempvoice-bot/src/index.js
Restart=on-failure
RestartSec=5
TimeoutStopSec=20
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/opt/tempvoice-bot/data

[Install]
WantedBy=multi-user.target

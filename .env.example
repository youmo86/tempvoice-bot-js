# Jeton privé du bot (Developer Portal > Bot). Ne pas le publier.
DISCORD_TOKEN=remplacer_par_le_token_du_bot
# Application ID (General Information). Une seule application pour tous les serveurs.
DISCORD_APPLICATION_ID=remplacer_par_application_id

DATABASE_PATH=./data/tempvoice.sqlite
# Attente avant suppression d'un vocal vide ; le retour d'un membre l'annule.
EMPTY_DELETE_DELAY_MS=10000
# Délai entre deux créations par un même membre, sur un même serveur.
CREATION_COOLDOWN_MS=10000
# Limite des salons temporaires gérés simultanément, pour chaque serveur.
MAX_TEMP_CHANNELS=30
